# isrenkamas geriausias klasteriu skaicius
kmeans=KMeans(n_clusters=2, random_state=42)
labels=kmeans.fit_predict(Z)
centers=kmeans.cluster_centers_

# klasteriu priskyrimas kriptovaliutoms
def soft_assign(z, centers):
    dist=np.sum((z[:, None]-centers[None, :])**2, axis=2)
    q=1.0/(1.0+dist)
    q=q/q.sum(axis=1, keepdims=True)
    return q
Q=soft_assign(Z, centers)
final_labels=np.argmax(Q, axis=1)
coin_clusters=dict(zip(log_returns.columns, final_labels))
clusters=pd.Series(coin_clusters)

