# 5 metodas. Maksimalaus Sharpe rodiklio (MSRP) metodas

# optimizacijos funckija
def neg_sharpe(w, mu, cov):
    ret=portfolio_return(w, mu)
    vol=portfolio_volatility(w, cov)
    return -ret/vol
n=len(selected)
init_w=np.ones(n)/n
bounds=[(0,1)]*n
constraints=({'type': 'eq', 'fun': lambda w: np.sum(w) - 1})
result_sharpe = minimize(
    neg_sharpe,
    init_w,
    args=(mu, cov),
    method="SLSQP",
    bounds=bounds,
    constraints=constraints
)
weights_sharpe=result_sharpe.x
ret_sharpe=portfolio_return(weights_sharpe, mu)
vol_sharpe=portfolio_volatility(weights_sharpe, cov)
