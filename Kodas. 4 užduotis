# Markowitz efektyvumo kreive
def efficient_frontier(mu, cov, points=50):
    n=len(mu)
    bounds=[(0,1)] * n
    init_w=np.ones(n) / n
    target_returns=np.linspace(mu.min(), mu.max(), points)
    vols=[]
    rets=[]
    for target in target_returns:
        constraints=[
            {'type': 'eq', 'fun': lambda w: np.sum(w) - 1},
            {'type': 'eq', 'fun': lambda w: portfolio_return(w, mu) - target}
        ]
        res=minimize(
            portfolio_volatility,
            init_w,
            args=(cov,),
            method='SLSQP',
            bounds=bounds,
            constraints=constraints
        )
        if res.success:
            vols.append(portfolio_volatility(res.x, cov))
            rets.append(target)
    return np.array(vols), np.array(rets)

vols, rets = efficient_frontier(mu, cov, points=50)
