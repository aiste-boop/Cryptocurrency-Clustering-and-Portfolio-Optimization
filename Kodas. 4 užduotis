# 3 metodas. salygines rizikos minimizavimo (CVAR) metodas

returns=log_returns[selected]
returns=returns.values # numpy formatas
n=returns.shape[1]
T=returns.shape[0]
def cvar_objective(x, returns, alpha=0.05):
    w=x[:n]
    z=x[n:]
    port_returns=returns @ w
    var=z[0]
    losses=-port_returns
    excess=losses-var
    excess_pos=np.maximum(excess, 0)
    cvar=var+(1/(alpha*T))*np.sum(excess_pos)
    return cvar
bounds=[(0,1)]*n+[(None, None)]
constraints=[
    {'type': 'eq', 'fun': lambda x: np.sum(x[:n]) - 1}
]
init=np.concatenate([np.ones(n)/n, [0]])
result=minimize(cvar_objective, init, args=(returns, 0.05), method="SLSQP", bounds=bounds, constraints=constraints)
weights_cvar=result.x[:n]
portfolio_return_cvar=(returns @ weights_cvar).mean()
portfolio_vol_cvar=np.std(returns @ weights_cvar)
print("graza:", portfolio_return_cvar)
print("kintamumas:", portfolio_vol_cvar)
cvar_weights=pd.DataFrame({
    "asset": selected,
