})
print(cvar_weights)

# 4 metodas. Globalaus minimalaus kintamumo (GMVP) metodas

def portfolio_return(w, mu):
    return w @ mu
def portfolio_variance(w, cov):
    return w.T @ cov @ w
def portfolio_volatility(w, cov):
    return np.sqrt(portfolio_variance(w, cov))

returns=log_returns[selected]
mu=returns.mean()
cov=returns.cov()
n=len(selected)

bounds=[(0, 1) for _ in range(n)] 
constraints=({'type': 'eq', 'fun': lambda w: np.sum(w) - 1})
init_w=np.ones(n)/n

def risk_objective(w, cov):
    return portfolio_volatility(w, cov)

# optimizacija
result_min_risk=minimize(
    risk_objective,
    init_w,
    args=(cov,),
    method="SLSQP",
    bounds=bounds,
    constraints=constraints
)
weights_min_risk=result_min_risk.x

ret_min=portfolio_return(weights_min_risk, mu)
vol_min=portfolio_volatility(weights_min_risk, cov)
portfolio_min_risk = pd.DataFrame({
