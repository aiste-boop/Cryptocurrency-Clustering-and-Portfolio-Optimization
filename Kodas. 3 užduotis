def best_3_with_penalty(assets, corr_matrix, existing_assets):
    best_combo=None
    best_score=float("inf")
    for combo in combinations(assets, 3):
        # vidine koreliacija (pirmame klasteryje)
        internal=np.mean([
            abs(corr_matrix.loc[a, b])
            for a, b in combinations(combo, 2)
        ])
        # isorine koreliacija (su jau atrinktomis kripto)
        external=np.mean([
            abs(corr_matrix.loc[a, b])
            for a in combo
            for b in existing_assets
        ])
        # bendra koreliacija
        score=0.5*internal+0.5*external
        if score<best_score:
            best_score=score
            best_combo=combo
    return best_combo, best_score
