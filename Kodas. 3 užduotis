# kriptovaliutu andersono-darlingo normalumo testas
results=[]
for coin in X.index: 
    data=X.loc[coin].dropna()
    data_std=(data-np.mean(data))/np.std(data)
    ad_result=anderson(data_std, dist='norm')
    AD=ad_result.statistic
    p_value=math.exp(1.29-5.71*AD+0.0186*(AD**2))
    results.append({
        "coin": coin,
        "AD_statistic": AD,
        "p_value": p_value
    })
