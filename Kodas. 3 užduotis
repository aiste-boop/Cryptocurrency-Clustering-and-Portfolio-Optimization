def best_3_low_corr(assets, corr_matrix):
    # pradines reiksmes
    best_combo = None
    best_score = float("inf")
    for combo in combinations(assets, 3):
        score=(
            abs(corr_matrix.loc[combo[0], combo[1]])+
            abs(corr_matrix.loc[combo[0], combo[2]])+
            abs(corr_matrix.loc[combo[1], combo[2]])
        ) /3
        if score<best_score:
            best_score=score
            best_combo=combo
    return best_combo, best_score
