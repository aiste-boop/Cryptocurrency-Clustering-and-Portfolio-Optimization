def portfolio_metrics(returns):
    equity=(1+returns).cumprod()
    metrics={}
    # sharpe rodiklis
    metrics["sharpe"]=returns.mean()/returns.std()
    # max drawdown
    peak=equity.cummax()
    dd=equity/peak-1
    metrics["max_drawdown"]=dd.min()
    # calmar rodiklis
    cagr=equity.iloc[-1]**(252/len(returns))-1
    metrics["calmar"]=cagr/abs(metrics["max_drawdown"])
